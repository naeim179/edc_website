{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "educational-platform",
        "vars": {
                "PAYTABS_PROFILE_ID": "185536",
                "PAYTABS_REGION": "JOR",
                "SITE_URL": "https://educational-platform.naeemmohmd8.workers.dev"
        },
        "workers_dev": true,
	"compatibility_date": "2026-09-13",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "vinext/server/fetch-handler",
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "none",
		"binding": "ASSETS"
	},
	"cache": {
		"enabled": true
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"images": {
		"binding": "IMAGES"
	},
	"kv_namespaces": [
		{
			"binding": "VINEXT_KV_CACHE",
			"id": "4f08a031373344e6a8b42e1182403ce1"
		}
	]
}