{
  "name": "educational-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs",
    "test:db": "bash tests/run-db-tests.sh",
    "typecheck": "next typegen && tsc --noEmit",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "npm run typecheck && npm test && vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@mux/mux-player-react": "3.13.4",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "@types/jsonwebtoken": "9.0.10",
    "@vinext/cloudflare": "1.0.0-beta.7",
    "jsonwebtoken": "9.0.3",
    "lucide-react": "1.28.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "1.4.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.39",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "supabase": "2.111.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "wrangler": "4.156.1"
  },
  "type": "module",
  "overrides": {
    "fflate": "0.7.5",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
