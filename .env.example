# Required for browser and server. Use your Supabase project's public values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix secrets with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical application URL, without a trailing slash.
SITE_URL=http://localhost:3000

# PayTabs: use a sandbox profile for local/staging testing.
PAYTABS_BASE_URL=https://secure-jordan.paytabs.com
PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=
CRON_SECRET=

# Optional manual CliQ payments: displayed to the customer.
CLIQ_ALIAS=
CLIQ_ACCOUNT_NAME=

# Optional Mux video upload and signed playback.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
# PEM private key; literal \n separators are supported.
MUX_SIGNING_PRIVATE_KEY=

# Optional Bunny Stream video upload.
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
